rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin activities collection - only admins can read/write
    match /adminActivities/{document} {
      allow read, write: if isAdmin();
    }

    // Users collection - admins can read/write, users can read their own data
    match /users/{userId} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if isAuthenticated();
    }
    // Testimonials collection
    match /testimonials/{testimonialId} {
      // Anyone can create a testimonial (for feedback form)
      allow create: if true;
      
      // Allow reading for:
      // 1. Admins (can read all)
      // 2. Anyone can read approved testimonials
      allow read: if isAdmin() || resource.data.status == 'approved';
      
      // Only admins can update testimonials (approve/reject)
      allow update: if isAdmin();
      
      // Only admins can delete testimonials
      allow delete: if isAdmin();
    }
    // Blogs collection - admins can read/write, authenticated users can create and update their own
    match /blogs/{blogId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.userId);
      allow delete: if isAdmin();
    }
		
        match /gallery/{postId} {
      // Anyone can read
      allow read: if true;

      // Only admins can write or update
      allow write: if isAdmin();

      // Any authenticated user can create (optional, remove if only admins should create)
      allow create: if isAuthenticated();
      
      // Optional: Allow delete only by admin
      allow delete: if isAdmin();
    }
    // Team members collection - admins can read/write
    match /teamMembers/{memberId} {
        allow read: if true;       // Public can read
        allow write: if isAdmin(); // Only admins can write
    }

    // Default deny for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}