# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Cloudinary Configuration (for blog image uploads ONLY - NO SECRET!)
# Get these from: https://cloudinary.com/console
# ⚠️ IMPORTANT: Replace ALL placeholder values with real credentials!
# ⚠️ DO NOT ADD VITE_CLOUDINARY_API_SECRET - Deletion is handled by backend!
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name  # ← Replace with actual cloud name (e.g., dxxxxxx)
VITE_CLOUDINARY_UPLOAD_PRESET=enarxi_unsigned
VITE_CLOUDINARY_UPLOAD_PRESET_OUR_TEAM=enarxi_our_team
VITE_CLOUDINARY_UPLOAD_PRESET_GALLERY=enarxi_gallery
VITE_CLOUDINARY_API_KEY=my-api-key  # ← Replace with actual API key (15-digit number)

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:5000/api  # Backend API URL (change for production)

# EmailJS Configuration (for contact form)
# Get these from: https://dashboard.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
